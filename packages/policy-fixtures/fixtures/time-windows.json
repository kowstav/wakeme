{
  "suite": "time-windows",
  "schemaVersion": 1,
  "description": "Recipient-local window and quiet-hour membership. Windows start on the listed ISO weekdays (Mon=1); end <= start means the window ends on the next day. start is inclusive, end exclusive. Expected values were computed by hand from the tz rules, not generated by any implementation.",
  "cases": [
    { "name": "weekday window start is inclusive", "timeZone": "America/New_York", "instant": "2026-10-19T10:30:00Z", "window": { "days": [1, 2, 3, 4, 5], "start": "06:30", "end": "09:30" }, "expected": true },
    { "name": "weekday window end is exclusive", "timeZone": "America/New_York", "instant": "2026-10-19T13:30:00Z", "window": { "days": [1, 2, 3, 4, 5], "start": "06:30", "end": "09:30" }, "expected": false },
    { "name": "one minute before end", "timeZone": "America/New_York", "instant": "2026-10-19T13:29:00Z", "window": { "days": [1, 2, 3, 4, 5], "start": "06:30", "end": "09:30" }, "expected": true },
    { "name": "Sunday not in weekday window", "timeZone": "America/New_York", "instant": "2026-10-18T11:00:00Z", "window": { "days": [1, 2, 3, 4, 5], "start": "06:30", "end": "09:30" }, "expected": false },
    { "name": "overnight window before midnight", "timeZone": "Europe/London", "instant": "2026-10-23T21:30:00Z", "window": { "days": [5], "start": "22:00", "end": "02:00" }, "expected": true },
    { "name": "overnight window after midnight belongs to previous day", "timeZone": "Europe/London", "instant": "2026-10-24T00:30:00Z", "window": { "days": [5], "start": "22:00", "end": "02:00" }, "expected": true },
    { "name": "overnight window end exclusive", "timeZone": "Europe/London", "instant": "2026-10-24T01:00:00Z", "window": { "days": [5], "start": "22:00", "end": "02:00" }, "expected": false },
    { "name": "overnight window not started on Saturday", "timeZone": "Europe/London", "instant": "2026-10-24T21:30:00Z", "window": { "days": [5], "start": "22:00", "end": "02:00" }, "expected": false },
    { "name": "Friday early morning is not Thursday's overnight window", "timeZone": "Europe/London", "instant": "2026-10-22T23:30:00Z", "window": { "days": [5], "start": "22:00", "end": "02:00" }, "expected": false },
    { "name": "half-hour offset zone start", "timeZone": "Asia/Kolkata", "instant": "2026-10-19T02:30:00Z", "window": { "days": [1, 2, 3, 4, 5, 6, 7], "start": "08:00", "end": "22:00" }, "expected": true },
    { "name": "half-hour offset zone end", "timeZone": "Asia/Kolkata", "instant": "2026-10-19T16:30:00Z", "window": { "days": [1, 2, 3, 4, 5, 6, 7], "start": "08:00", "end": "22:00" }, "expected": false },
    { "name": "half-hour offset zone before start", "timeZone": "Asia/Kolkata", "instant": "2026-10-19T02:29:00Z", "window": { "days": [1, 2, 3, 4, 5, 6, 7], "start": "08:00", "end": "22:00" }, "expected": false },
    { "name": "Sunday overnight window wraps into Monday", "timeZone": "Asia/Tokyo", "instant": "2026-10-18T15:30:00Z", "window": { "days": [7], "start": "23:00", "end": "01:00" }, "expected": true }
  ],
  "quietCases": [
    { "name": "late evening is quiet", "timeZone": "America/Los_Angeles", "instant": "2026-10-20T06:00:00Z", "quiet": { "enabled": true, "start": "22:00", "end": "07:00" }, "expected": true },
    { "name": "quiet end exclusive", "timeZone": "America/Los_Angeles", "instant": "2026-10-20T14:00:00Z", "quiet": { "enabled": true, "start": "22:00", "end": "07:00" }, "expected": false },
    { "name": "one minute before quiet end", "timeZone": "America/Los_Angeles", "instant": "2026-10-20T13:59:00Z", "quiet": { "enabled": true, "start": "22:00", "end": "07:00" }, "expected": true },
    { "name": "disabled quiet hours", "timeZone": "America/Los_Angeles", "instant": "2026-10-20T06:00:00Z", "quiet": { "enabled": false, "start": "22:00", "end": "07:00" }, "expected": false }
  ]
}
