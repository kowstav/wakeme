{
  "name": "Wake Me design tokens",
  "version": 2,
  "direction": "Daybreak (doc: docs/design/system.md). Warm daylight + quiet night: off-white cream surfaces and dark ink by day; warm, low-glare ink surfaces by night (same hue family as the day, so the yellow doesn't glare against cold slate). Duck yellow is a fill and a celebration colour, never body text on light backgrounds (accentText carries text). Butter containers mark selection and hero moments. Restrained blue for information and focus. Red only for destructive actions and SOS. Values were chosen in OKLCH: light-mode semantic text colours share lightness L≈0.50, dark-mode ones L≈0.76–0.84, so no status shouts louder than another.",
  "color": {
    "surface": { "light": "#FBF8F1", "dark": "#151311" },
    "surfaceRaised": { "light": "#FFFFFF", "dark": "#201E1A" },
    "surfaceSunken": { "light": "#F3EEE3", "dark": "#0D0C0A" },
    "surfaceOverlay": { "light": "#FFFFFF", "dark": "#292622" },
    "border": { "light": "#E2DCCF", "dark": "#33302B" },
    "outline": { "light": "#877F73", "dark": "#79736C", "lightHc": "#5B5449", "darkHc": "#A49D94" },
    "textPrimary": { "light": "#1B1A17", "dark": "#F3EFE6" },
    "textSecondary": { "light": "#5C5850", "dark": "#B3ADA2", "lightHc": "#403D35", "darkHc": "#D5D0C7" },
    "accent": { "light": "#F2B705", "dark": "#F5C518" },
    "accentPressed": { "light": "#DDA315", "dark": "#DFB127" },
    "textOnAccent": { "light": "#1B1A17", "dark": "#1B1A17" },
    "accentContainer": { "light": "#FBE9B0", "dark": "#42330A" },
    "onAccentContainer": { "light": "#473101", "dark": "#FAE39F" },
    "accentText": { "light": "#835C00", "dark": "#F5C518", "lightHc": "#674600", "darkHc": "#FBD452" },
    "info": { "light": "#2F5D9E", "dark": "#8DB4F0" },
    "infoContainer": { "light": "#E5EFFF", "dark": "#1D2E47" },
    "success": { "light": "#2B7449", "dark": "#6FCF97" },
    "successContainer": { "light": "#DAF7E3", "dark": "#173523" },
    "warning": { "light": "#9C4701", "dark": "#F7A062" },
    "warningContainer": { "light": "#FFEADB", "dark": "#442916" },
    "danger": { "light": "#B3261E", "dark": "#FF8A80" },
    "dangerContainer": { "light": "#FFE9E6", "dark": "#47211E" },
    "dangerFill": { "light": "#B3261E", "dark": "#B3261E" },
    "textOnDanger": { "light": "#FFFFFF", "dark": "#FFFFFF" },
    "focus": { "light": "#2F5D9E", "dark": "#8DB4F0" },
    "alarmBackground": { "light": "#151311", "dark": "#0D0C0A" },
    "alarmText": { "light": "#F3EFE6", "dark": "#F3EFE6" }
  },
  "illustration": {
    "note": "The Wake Me duck (DuckMark on both platforms; 64-unit geometry in docs/design/system.md). Body and wing use accent and accentPressed; these stay the same in both themes. Decorative only: never carries meaning.",
    "duckBeak": "#EE8A2F",
    "duckBeakShade": "#D9701C",
    "duckEye": "#1B1A17",
    "duckEyeHighlight": "#FFFFFF"
  },
  "avatar": {
    "note": "Friend monogram tints: six muted hues at equal OKLCH lightness (L 0.90 light / 0.34 dark, C≈0.055), so no friend looks more important than another. Red hues are excluded (danger keeps its meaning). Text on them is textPrimary.",
    "tints": [
      { "name": "butter", "light": "#EBDEB5", "dark": "#423712" },
      { "name": "apricot", "light": "#FAD6BA", "dark": "#4D3119" },
      { "name": "sage", "light": "#C5E9CB", "dark": "#224028" },
      { "name": "sea", "light": "#B4EAEC", "dark": "#064043" },
      { "name": "sky", "light": "#C9E0FF", "dark": "#243954" },
      { "name": "lilac", "light": "#E6D5FC", "dark": "#3F304F" }
    ]
  },
  "contrast": [
    { "fg": "textPrimary", "bg": "surface", "min": 7 },
    { "fg": "textPrimary", "bg": "surfaceRaised", "min": 7 },
    { "fg": "textPrimary", "bg": "surfaceOverlay", "min": 7 },
    { "fg": "textSecondary", "bg": "surface", "min": 4.5 },
    { "fg": "textSecondary", "bg": "surfaceRaised", "min": 4.5 },
    { "fg": "textSecondary", "bg": "surfaceSunken", "min": 4.5 },
    { "fg": "textSecondary", "bg": "surfaceOverlay", "min": 4.5 },
    { "fg": "accentText", "bg": "surface", "min": 4.5 },
    { "fg": "accentText", "bg": "surfaceRaised", "min": 4.5 },
    { "fg": "accentText", "bg": "surfaceSunken", "min": 4.5 },
    { "fg": "info", "bg": "surface", "min": 4.5 },
    { "fg": "info", "bg": "surfaceRaised", "min": 4.5 },
    { "fg": "success", "bg": "surface", "min": 4.5 },
    { "fg": "success", "bg": "surfaceRaised", "min": 4.5 },
    { "fg": "warning", "bg": "surface", "min": 4.5 },
    { "fg": "warning", "bg": "surfaceRaised", "min": 4.5 },
    { "fg": "danger", "bg": "surface", "min": 4.5 },
    { "fg": "danger", "bg": "surfaceRaised", "min": 4.5 },
    { "fg": "textOnAccent", "bg": "accent", "min": 4.5 },
    { "fg": "textOnAccent", "bg": "accentPressed", "min": 4.5 },
    { "fg": "onAccentContainer", "bg": "accentContainer", "min": 7 },
    { "fg": "textPrimary", "bg": "accentContainer", "min": 7 },
    { "fg": "info", "bg": "infoContainer", "min": 4.5 },
    { "fg": "textPrimary", "bg": "infoContainer", "min": 7 },
    { "fg": "success", "bg": "successContainer", "min": 4.5 },
    { "fg": "warning", "bg": "warningContainer", "min": 4.5 },
    { "fg": "danger", "bg": "dangerContainer", "min": 4.5 },
    { "fg": "textPrimary", "bg": "dangerContainer", "min": 7 },
    { "fg": "textOnDanger", "bg": "dangerFill", "min": 4.5 },
    { "fg": "alarmText", "bg": "alarmBackground", "min": 7 },
    { "fg": "outline", "bg": "surface", "min": 3, "note": "non-text (WCAG 1.4.11): text-field, chip and control boundaries" },
    { "fg": "outline", "bg": "surfaceRaised", "min": 3, "note": "non-text" },
    { "fg": "outline", "bg": "surfaceOverlay", "min": 3, "note": "non-text: fields in dialogs and sheets" },
    { "fg": "focus", "bg": "surface", "min": 3, "note": "non-text: keyboard focus indicator" },
    { "fg": "focus", "bg": "surfaceSunken", "min": 3, "note": "non-text" },
    { "fg": "border", "bg": "surface", "min": 1.2, "note": "decorative separator only; state is never conveyed by border colour alone" }
  ],
  "spacing": { "xxs": 4, "xs": 8, "sm": 12, "md": 16, "lg": 24, "xl": 32, "xxl": 48 },
  "layout": {
    "note": "Semantic spacing on the 4-point scale. Tight groups, generous separation, and more space above a heading than below it.",
    "screenMarginAndroid": 16,
    "screenMarginIos": 20,
    "readableWidth": 640,
    "cardPadding": 16,
    "cardGap": 12,
    "titleGap": 4,
    "fieldLabelGap": 8,
    "controlGap": 12,
    "sectionGap": 24,
    "sectionTopExtra": 8
  },
  "radius": { "sm": 8, "md": 14, "lg": 20, "xl": 28, "pill": 999 },
  "touchTarget": { "iosPoints": 44, "androidDp": 48, "alarmControlMin": 72, "controlHeight": 52 },
  "component": {
    "note": "Visible sizes; every interactive element keeps at least touchTarget.iosPoints / androidDp of hit area even when its artwork is smaller.",
    "buttonHeight": 52,
    "alarmButtonHeight": 72,
    "buttonPaddingX": 24,
    "compactControlHeight": 40,
    "chipHeight": 32,
    "iconButtonVisual": 40,
    "iconSize": 24,
    "iconSizeSmall": 20,
    "avatarRow": 44,
    "avatarHeader": 56,
    "statusPillPaddingX": 12,
    "statusPillPaddingY": 6,
    "dayToggleMax": 44
  },
  "opacity": { "disabled": 0.38, "pressedOverlay": 0.1, "scrim": 0.45 },
  "elevation": {
    "note": "Light mode lifts cards with a hairline border and one soft ink shadow; dark mode uses lighter tonal surfaces and no shadow (shadows vanish on dark ink).",
    "cardShadowOpacity": 0.06,
    "cardShadowRadius": 10,
    "cardShadowY": 2,
    "cardAndroidDp": 2,
    "overlayShadowOpacity": 0.12,
    "overlayShadowRadius": 24,
    "overlayShadowY": 8,
    "overlayAndroidDp": 6
  },
  "type": {
    "note": "Semantic roles, chosen by purpose. Android sizes are sp (follow font scale; maxScale caps already-large numerals so they never overflow). iOS maps each role to a Dynamic Type text style, so it follows the reading size; Android and iOS differ where platform conventions do (Material 28 sp screen titles vs iOS 34 pt large titles). Tracking is in em. Body tracking is tightened from Material’s 0.5 sp, which reads airy in Roboto at 16 sp. Figures are tabular everywhere.",
    "roles": {
      "alarmTime": { "use": "Alarm clock face", "size": 76, "line": 80, "weight": 700, "tracking": -0.02, "maxScale": 1.3, "ios": "largeTitle", "iosWeight": "bold", "iosSize": 76 },
      "timeDisplay": { "use": "Routine time on detail and editor", "size": 56, "line": 60, "weight": 600, "tracking": -0.02, "maxScale": 1.5, "ios": "largeTitle", "iosWeight": "semibold", "iosSize": 56 },
      "timeInline": { "use": "Routine time on cards and lists", "size": 32, "line": 36, "weight": 600, "tracking": -0.01, "ios": "largeTitle", "iosWeight": "semibold" },
      "hero": { "use": "Welcome headline", "size": 32, "line": 40, "weight": 700, "tracking": -0.015, "ios": "largeTitle", "iosWeight": "bold" },
      "screenTitle": { "use": "Top of a screen", "size": 28, "line": 36, "weight": 700, "tracking": -0.01, "ios": "largeTitle", "iosWeight": "bold" },
      "prominent": { "use": "Alarm label, challenge title, question", "size": 24, "line": 32, "weight": 600, "tracking": 0, "ios": "title2", "iosWeight": "semibold" },
      "section": { "use": "Header between groups (outside cards); large alarm button labels", "size": 22, "line": 28, "weight": 600, "tracking": 0, "ios": "title2", "iosWeight": "semibold" },
      "cardTitle": { "use": "Card and list-row titles, button labels", "size": 17, "line": 24, "weight": 600, "tracking": 0, "ios": "headline", "iosWeight": "semibold" },
      "fieldLabel": { "use": "Label above a group of form controls", "size": 14, "line": 20, "weight": 600, "tracking": 0.007, "ios": "subheadline", "iosWeight": "semibold" },
      "body": { "use": "Paragraphs and sentences", "size": 16, "line": 24, "weight": 400, "tracking": 0.009, "ios": "body", "iosWeight": "regular" },
      "supporting": { "use": "Secondary line under a title, metadata", "size": 14, "line": 20, "weight": 400, "tracking": 0.007, "ios": "subheadline", "iosWeight": "regular" },
      "label": { "use": "Status pills, chips", "size": 14, "line": 20, "weight": 600, "tracking": 0.007, "ios": "subheadline", "iosWeight": "medium" },
      "caption": { "use": "Trail step labels, footnotes; the floor for anything people must read", "size": 12, "line": 16, "weight": 500, "tracking": 0.02, "ios": "caption", "iosWeight": "medium" }
    }
  },
  "motion": {
    "personality": "Effortless in daily use, joyful at the quack and on success, calm and instant in alarm, safety and escape flows.",
    "durationMs": { "quick": 120, "standard": 220, "emphasized": 320, "exit": 180, "reducedCrossfade": 150, "quack": 600, "celebrate": 900 },
    "spring": {
      "note": "iOS uses response/damping directly (Animation.spring(response:dampingFraction:)); Android uses dampingRatio = damping and stiffness = (2π / response)².",
      "press": { "response": 0.2, "damping": 0.9 },
      "snappy": { "response": 0.3, "damping": 0.86 },
      "smooth": { "response": 0.45, "damping": 1 },
      "playful": { "response": 0.4, "damping": 0.55 }
    },
    "pressScale": 0.97,
    "staggerMs": 40,
    "staggerMaxItems": 5,
    "reducedMotion": "Translation, scale and rotation become an opacity crossfade of at most reducedCrossfade ms; nothing loops; the quack shows a still duck and still sound marks."
  },
  "haptics": {
    "note": "Vocabulary only; the system haptics setting decides whether anything is felt. Never during an alarm or SOS beyond the system's own.",
    "selection": { "ios": "SensoryFeedback.selection", "android": "HapticFeedbackType.SegmentTick" },
    "toggle": { "ios": "SensoryFeedback.selection", "android": "HapticFeedbackType.ToggleOn / ToggleOff" },
    "sent": { "ios": "SensoryFeedback.success", "android": "HapticFeedbackType.Confirm" },
    "failed": { "ios": "SensoryFeedback.warning", "android": "HapticFeedbackType.Reject" },
    "wrongAnswer": { "ios": "SensoryFeedback.impact(weight: .light)", "android": "HapticFeedbackType.Reject" },
    "completed": { "ios": "SensoryFeedback.success", "android": "HapticFeedbackType.Confirm" }
  }
}
