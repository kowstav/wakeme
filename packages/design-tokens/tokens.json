{
  "name": "Wake Me design tokens",
  "version": 3,
  "direction": "Bloom (docs/design/system.md, ADR 0021). A white canvas with flat neutral cards, one lime-green action colour with forest-green ink, and a family of petal colours for things of the same kind (friends, tiles, presets, icon chips), the way one flower carries many petal colours. Colours are sampled from the owner's two reference images (a Wise app board and a painted flower; values in docs/design/research-2026-10-21-top-apps.md): bright fills are exact samples, and each family's ink (text on the fill) and dark-mode fill share the fill's OKLCH hue. Lime is for buttons and selection; forest is for heroes and headlines; status colours keep their meaning (danger red only for destructive actions and SOS).",
  "color": {
    "surface": { "light": "#FFFFFF", "dark": "#0E110B" },
    "surfaceRaised": { "light": "#FFFFFF", "dark": "#181C15" },
    "surfaceNeutral": { "light": "#EBEDEA", "dark": "#1E221B" },
    "surfaceSunken": { "light": "#F2F4F0", "dark": "#080A06" },
    "surfacePressed": { "light": "#DDE0DA", "dark": "#2B3027" },
    "surfaceOverlay": { "light": "#FFFFFF", "dark": "#22261F" },
    "border": { "light": "#E3E5E0", "dark": "#2C3128" },
    "outline": { "light": "#767876", "dark": "#858C80", "lightHc": "#545653", "darkHc": "#A9B0A3" },
    "textPrimary": { "light": "#0E0F0C", "dark": "#F2F5EE" },
    "textSecondary": { "light": "#454745", "dark": "#B5BBAE", "lightHc": "#2E302D", "darkHc": "#D7DCD1" },
    "accent": { "light": "#9FE870", "dark": "#9FE870" },
    "accentPressed": { "light": "#8ED45E", "dark": "#8ED45E" },
    "textOnAccent": { "light": "#163300", "dark": "#163300" },
    "accentContainer": { "light": "#E2F6D5", "dark": "#203F05" },
    "onAccentContainer": { "light": "#163300", "dark": "#CDF2B4" },
    "accentText": { "light": "#163300", "dark": "#9FE870", "lightHc": "#0B1A00", "darkHc": "#C4F5A3" },
    "brandInk": { "light": "#163300", "dark": "#9FE870" },
    "heroFill": { "light": "#163300", "dark": "#163300" },
    "onHero": { "light": "#9FE870", "dark": "#9FE870" },
    "onHeroSecondary": { "light": "#CDF2B4", "dark": "#CDF2B4" },
    "info": { "light": "#2A5E98", "dark": "#95D3E2" },
    "infoContainer": { "light": "#DEEFF3", "dark": "#1E3A41" },
    "success": { "light": "#2F5711", "dark": "#9FE870" },
    "successContainer": { "light": "#E2F6D5", "dark": "#203F05" },
    "warning": { "light": "#8A4100", "dark": "#FAAF5F" },
    "warningContainer": { "light": "#FDE7D2", "dark": "#4E2D02" },
    "danger": { "light": "#A8200D", "dark": "#FF8A7A" },
    "dangerContainer": { "light": "#FFE6E1", "dark": "#4A1A14" },
    "dangerFill": { "light": "#A8200D", "dark": "#A8200D" },
    "textOnDanger": { "light": "#FFFFFF", "dark": "#FFFFFF" },
    "focus": { "light": "#2A5E98", "dark": "#95D3E2" },
    "alarmBackground": { "light": "#163300", "dark": "#0B1A00" },
    "alarmText": { "light": "#F2F5EE", "dark": "#F2F5EE" }
  },
  "palette": {
    "note": "Petal families for things of the same kind: each friend, bento tile, routine preset and icon chip takes one. `fill` is the tile or chip; `ink` is text and icons on it (checked at 4.5:1 in both themes). Light fills are exact samples from the reference images; inks marked derived share the fill's OKLCH hue. Dark mode swaps to a deep fill of the same hue with the bright colour as ink. Families never carry status: warnings, errors and success keep the semantic colours.",
    "families": {
      "lime": { "light": { "fill": "#9FE870", "ink": "#163300" }, "dark": { "fill": "#203F05", "ink": "#9FE870" }, "source": "Wise bright green / forest green (reference 1)" },
      "orchid": { "light": { "fill": "#DE82C3", "ink": "#510841" }, "dark": { "fill": "#4E2442", "ink": "#DE82C3" }, "source": "ribbon pink (reference 1); ink derived" },
      "sky": { "light": { "fill": "#95D3E2", "ink": "#02343E" }, "dark": { "fill": "#1E3A41", "ink": "#95D3E2" }, "source": "ribbon light blue (reference 1); ink derived" },
      "apricot": { "light": { "fill": "#FAAF5F", "ink": "#6C1C0F" }, "dark": { "fill": "#4E2D02", "ink": "#FAAF5F" }, "source": "petal apricot and petal maroon (reference 2)" },
      "gold": { "light": { "fill": "#F8C53D", "ink": "#683305" }, "dark": { "fill": "#443300", "ink": "#F8C53D" }, "source": "coin gold and coin brown (reference 1)" },
      "aqua": { "light": { "fill": "#A4F2ED", "ink": "#045B49" }, "dark": { "fill": "#173C3A", "ink": "#A4F2ED" }, "source": "globe aqua and globe teal (reference 1)" },
      "periwinkle": { "light": { "fill": "#9386E4", "ink": "#251454" }, "dark": { "fill": "#282249", "ink": "#9386E4" }, "source": "ribbon violet (reference 1); ink derived" },
      "forest": { "light": { "fill": "#163300", "ink": "#9FE870" }, "dark": { "fill": "#163300", "ink": "#9FE870" }, "source": "Wise forest green with bright green (reference 1)" }
    },
    "avatars": ["lime", "orchid", "sky", "apricot", "gold", "aqua", "periwinkle"]
  },
  "illustration": {
    "note": "The Wake Me duck (DuckMark on both platforms; 64-unit geometry in docs/design/system.md). Coin gold body, amber wing, petal-orange beak and forest eye, all sampled from the reference images. The same in both themes. Decorative only: never carries meaning.",
    "duckBody": "#F8C53D",
    "duckWing": "#D7961A",
    "duckBeak": "#ED7737",
    "duckBeakShade": "#D03E20",
    "duckEye": "#163300",
    "duckEyeHighlight": "#FFFFFF"
  },
  "contrast": [
    { "fg": "textPrimary", "bg": "surface", "min": 7 },
    { "fg": "textPrimary", "bg": "surfaceRaised", "min": 7 },
    { "fg": "textPrimary", "bg": "surfaceNeutral", "min": 7 },
    { "fg": "textPrimary", "bg": "surfacePressed", "min": 7 },
    { "fg": "textPrimary", "bg": "surfaceOverlay", "min": 7 },
    { "fg": "textSecondary", "bg": "surface", "min": 4.5 },
    { "fg": "textSecondary", "bg": "surfaceRaised", "min": 4.5 },
    { "fg": "textSecondary", "bg": "surfaceNeutral", "min": 4.5 },
    { "fg": "textSecondary", "bg": "surfaceSunken", "min": 4.5 },
    { "fg": "textSecondary", "bg": "surfaceOverlay", "min": 4.5 },
    { "fg": "accentText", "bg": "surface", "min": 4.5 },
    { "fg": "accentText", "bg": "surfaceNeutral", "min": 4.5 },
    { "fg": "accentText", "bg": "surfaceSunken", "min": 4.5 },
    { "fg": "brandInk", "bg": "surface", "min": 7 },
    { "fg": "onHero", "bg": "heroFill", "min": 7 },
    { "fg": "onHeroSecondary", "bg": "heroFill", "min": 7 },
    { "fg": "info", "bg": "surface", "min": 4.5 },
    { "fg": "info", "bg": "surfaceNeutral", "min": 4.5 },
    { "fg": "success", "bg": "surface", "min": 4.5 },
    { "fg": "success", "bg": "surfaceNeutral", "min": 4.5 },
    { "fg": "warning", "bg": "surface", "min": 4.5 },
    { "fg": "warning", "bg": "surfaceNeutral", "min": 4.5 },
    { "fg": "danger", "bg": "surface", "min": 4.5 },
    { "fg": "danger", "bg": "surfaceNeutral", "min": 4.5 },
    { "fg": "textOnAccent", "bg": "accent", "min": 4.5 },
    { "fg": "textOnAccent", "bg": "accentPressed", "min": 4.5 },
    { "fg": "onAccentContainer", "bg": "accentContainer", "min": 7 },
    { "fg": "textPrimary", "bg": "accentContainer", "min": 7 },
    { "fg": "info", "bg": "infoContainer", "min": 4.5 },
    { "fg": "textPrimary", "bg": "infoContainer", "min": 7 },
    { "fg": "success", "bg": "successContainer", "min": 4.5 },
    { "fg": "warning", "bg": "warningContainer", "min": 4.5 },
    { "fg": "danger", "bg": "dangerContainer", "min": 4.5 },
    { "fg": "textPrimary", "bg": "dangerContainer", "min": 7 },
    { "fg": "textOnDanger", "bg": "dangerFill", "min": 4.5 },
    { "fg": "alarmText", "bg": "alarmBackground", "min": 7 },
    { "fg": "outline", "bg": "surface", "min": 3, "note": "non-text (WCAG 1.4.11): text-field, switch and selection boundaries" },
    { "fg": "outline", "bg": "surfaceRaised", "min": 3, "note": "non-text" },
    { "fg": "outline", "bg": "surfaceNeutral", "min": 3, "note": "non-text: fields and toggles inside cards" },
    { "fg": "outline", "bg": "surfaceOverlay", "min": 3, "note": "non-text: fields in dialogs and sheets" },
    { "fg": "focus", "bg": "surface", "min": 3, "note": "non-text: keyboard focus indicator" },
    { "fg": "focus", "bg": "surfaceNeutral", "min": 3, "note": "non-text" },
    { "fg": "border", "bg": "surface", "min": 1.2, "note": "decorative separator only; state is never conveyed by border colour alone" }
  ],
  "spacing": { "xxs": 4, "xs": 8, "sm": 12, "md": 16, "lg": 24, "xl": 32, "xxl": 48 },
  "layout": {
    "note": "Semantic spacing on the 4-point scale. Tight groups, generous separation, and more space above a heading than below it. Bento tiles sit 12 apart, the same as cards in a list, so a grid and a list share one rhythm.",
    "screenMarginAndroid": 16,
    "screenMarginIos": 20,
    "readableWidth": 640,
    "cardPadding": 16,
    "heroPadding": 20,
    "cardGap": 12,
    "titleGap": 4,
    "fieldLabelGap": 8,
    "controlGap": 12,
    "sectionGap": 24,
    "sectionTopExtra": 8
  },
  "radius": { "sm": 12, "md": 16, "lg": 24, "xl": 32, "pill": 999 },
  "touchTarget": { "iosPoints": 44, "androidDp": 48, "alarmControlMin": 72, "controlHeight": 56 },
  "component": {
    "note": "Visible sizes; every interactive element keeps at least touchTarget.iosPoints / androidDp of hit area even when its artwork is smaller. Full-width actions are 56 tall (Material 3 medium button, the thumb-friendly height the reviewed apps use); compact pills in headers are 40.",
    "buttonHeight": 56,
    "alarmButtonHeight": 72,
    "buttonPaddingX": 24,
    "compactControlHeight": 40,
    "chipHeight": 36,
    "iconButtonVisual": 44,
    "iconChip": 40,
    "actionCircle": 56,
    "iconSize": 24,
    "iconSizeSmall": 20,
    "iconSizeLarge": 28,
    "avatarRow": 44,
    "avatarHeader": 72,
    "tileMinHeight": 116,
    "statusPillPaddingX": 12,
    "statusPillPaddingY": 6,
    "dayToggleMax": 44
  },
  "opacity": { "disabled": 0.38, "pressedOverlay": 0.1, "scrim": 0.45 },
  "elevation": {
    "note": "Cards and tiles are flat: colour separates them from the page (neutral grey on white by day, a lighter tonal surface by night), as in every reviewed app. Only overlays (sheets, menus, dialogs) cast a shadow.",
    "overlayShadowOpacity": 0.12,
    "overlayShadowRadius": 24,
    "overlayShadowY": 8,
    "overlayAndroidDp": 6
  },
  "type": {
    "note": "Semantic native type roles. Sentence-case system headlines, medium tabular time numerals and readable body text. Preserve font scaling, Dynamic Type, contrast and alarm escape control sizes.",
    "roles": {
      "display": { "use": "Welcome and celebration headline, sentence case", "size": 36, "line": 42, "weight": 700, "tracking": -0.01, "maxScale": 1.3, "family": "system", "uppercase": false, "ios": "largeTitle", "iosWeight": "bold", "iosSize": 36 },
      "alarmTime": { "use": "Alarm clock face", "size": 80, "line": 84, "weight": 700, "tracking": -0.02, "maxScale": 1.3, "ios": "largeTitle", "iosWeight": "bold", "iosSize": 80 },
      "timeDisplay": { "use": "Routine time on heroes, detail and editor", "size": 56, "line": 62, "weight": 500, "tracking": -0.02, "maxScale": 1.5, "ios": "largeTitle", "iosWeight": "medium", "iosSize": 56 },
      "timeInline": { "use": "Routine time on cards and lists", "size": 32, "line": 38, "weight": 500, "tracking": -0.01, "ios": "largeTitle", "iosWeight": "medium" },
      "hero": { "use": "Large headings on full-screen states", "size": 30, "line": 36, "weight": 600, "tracking": -0.015, "ios": "largeTitle", "iosWeight": "semibold" },
      "screenTitle": { "use": "Top of a screen", "size": 28, "line": 34, "weight": 600, "tracking": -0.02, "ios": "largeTitle", "iosWeight": "semibold" },
      "prominent": { "use": "Alarm label, challenge title, question", "size": 24, "line": 30, "weight": 700, "tracking": -0.01, "ios": "title2", "iosWeight": "bold" },
      "section": { "use": "Header between groups (outside cards); large alarm button labels", "size": 20, "line": 26, "weight": 600, "tracking": -0.01, "ios": "title2", "iosWeight": "semibold" },
      "cardTitle": { "use": "Card and list-row titles, button labels", "size": 17, "line": 24, "weight": 600, "tracking": 0, "ios": "headline", "iosWeight": "semibold" },
      "tileTitle": { "use": "Bento tile titles", "size": 16, "line": 20, "weight": 600, "tracking": 0, "ios": "callout", "iosWeight": "semibold" },
      "fieldLabel": { "use": "Label above a group of form controls; small section headers", "size": 14, "line": 20, "weight": 600, "tracking": 0.007, "ios": "subheadline", "iosWeight": "semibold" },
      "body": { "use": "Paragraphs and sentences", "size": 16, "line": 24, "weight": 400, "tracking": 0.009, "ios": "body", "iosWeight": "regular" },
      "supporting": { "use": "Secondary line under a title, metadata", "size": 14, "line": 20, "weight": 400, "tracking": 0.007, "ios": "subheadline", "iosWeight": "regular" },
      "label": { "use": "Status pills, chips", "size": 14, "line": 20, "weight": 600, "tracking": 0.007, "ios": "subheadline", "iosWeight": "semibold" },
      "actionLabel": { "use": "The short word under a quick-action circle", "size": 13, "line": 16, "weight": 600, "tracking": 0.01, "ios": "footnote", "iosWeight": "semibold" },
      "caption": { "use": "Trail step labels, footnotes; the floor for anything people must read", "size": 12, "line": 16, "weight": 500, "tracking": 0.02, "ios": "caption", "iosWeight": "medium" }
    }
  },
  "motion": {
    "personality": "Effortless in daily use, joyful at the quack and on success, calm and instant in alarm, safety and escape flows.",
    "durationMs": { "quick": 120, "standard": 220, "emphasized": 320, "exit": 180, "reducedCrossfade": 150, "quack": 600, "celebrate": 900 },
    "spring": {
      "note": "iOS uses response/damping directly (Animation.spring(response:dampingFraction:)); Android uses dampingRatio = damping and stiffness = (2π / response)².",
      "press": { "response": 0.2, "damping": 0.9 },
      "snappy": { "response": 0.3, "damping": 0.86 },
      "smooth": { "response": 0.45, "damping": 1 },
      "playful": { "response": 0.4, "damping": 0.55 }
    },
    "pressScale": 0.97,
    "staggerMs": 40,
    "staggerMaxItems": 5,
    "reducedMotion": "Translation, scale and rotation become an opacity crossfade of at most reducedCrossfade ms; nothing loops; the quack shows a still duck and still sound marks."
  },
  "haptics": {
    "note": "Vocabulary only; the system haptics setting decides whether anything is felt. Never during an alarm or SOS beyond the system's own.",
    "selection": { "ios": "SensoryFeedback.selection", "android": "HapticFeedbackType.SegmentTick" },
    "toggle": { "ios": "SensoryFeedback.selection", "android": "HapticFeedbackType.ToggleOn / ToggleOff" },
    "sent": { "ios": "SensoryFeedback.success", "android": "HapticFeedbackType.Confirm" },
    "failed": { "ios": "SensoryFeedback.warning", "android": "HapticFeedbackType.Reject" },
    "wrongAnswer": { "ios": "SensoryFeedback.impact(weight: .light)", "android": "HapticFeedbackType.Reject" },
    "completed": { "ios": "SensoryFeedback.success", "android": "HapticFeedbackType.Confirm" }
  }
}
