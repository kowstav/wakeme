  "motion": {
    "personality": "Effortless in daily use, joyful at the quack and on success, calm and instant in alarm, safety and escape flows.",
    "durationMs": {
      "quick": 120,
      "standard": 220,
      "emphasized": 320,
      "exit": 180,
      "reducedCrossfade": 150,
      "quack": 600,
      "celebrate": 900
    },
    "spring": {
      "note": "iOS uses response/damping directly (Animation.spring(response:dampingFraction:)); Android uses dampingRatio = damping and stiffness = (2\u03c0 / response)\u00b2.",
      "press": {
        "response": 0.2,
        "damping": 0.9
      },
      "snappy": {
        "response": 0.3,
        "damping": 0.86
      },
      "smooth": {
        "response": 0.45,
        "damping": 1
      },
      "playful": {
        "response": 0.4,
        "damping": 0.55
      }
    },
    "pressScale": 0.97,
    "staggerMs": 40,
    "staggerMaxItems": 5,
    "reducedMotion": "Translation, scale and rotation become an opacity crossfade of at most reducedCrossfade ms; nothing loops; the quack shows a still duck and still sound marks."
  },
  "haptics": {
    "note": "Vocabulary only; the system haptics setting decides whether anything is felt. Never during an alarm or SOS beyond the system's own.",
    "selection": {
      "ios": "SensoryFeedback.selection",
      "android": "HapticFeedbackType.SegmentTick"
    },
    "toggle": {
      "ios": "SensoryFeedback.selection",
      "android": "HapticFeedbackType.ToggleOn / ToggleOff"
    },
    "sent": {
      "ios": "SensoryFeedback.success",
      "android": "HapticFeedbackType.Confirm"
    },
    "failed": {
      "ios": "SensoryFeedback.warning",
      "android": "HapticFeedbackType.Reject"
    },
    "wrongAnswer": {
      "ios": "SensoryFeedback.impact(weight: .light)",
      "android": "HapticFeedbackType.Reject"
    },
    "completed": {
      "ios": "SensoryFeedback.success",
      "android": "HapticFeedbackType.Confirm"
    }
  }
}
