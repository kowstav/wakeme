      "display": {
        "use": "Welcome and celebration headline, sentence case",
        "size": 34,
        "line": 40,
        "weight": 600,
        "tracking": -0.01,
        "maxScale": 1.3,
        "family": "brand",
        "uppercase": false,
        "ios": "largeTitle",
        "iosWeight": "semibold",
        "iosSize": 34
      },
