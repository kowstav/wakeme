{
  "name": "Wake Me design tokens",
  "version": 1,
  "direction": "Warm daylight + quiet night. Off-white surfaces and dark ink by day; deep, low-glare night surfaces. Duck-yellow accent is a fill, never body text on light backgrounds. Restrained blue for information. Red only for destructive actions and SOS.",
  "color": {
    "surface":        { "light": "#FBF8F1", "dark": "#121417" },
    "surfaceRaised":  { "light": "#FFFFFF", "dark": "#1C1F24" },
    "surfaceSunken":  { "light": "#F3EEE3", "dark": "#0C0E10" },
    "border":         { "light": "#E2DCCF", "dark": "#2C3036" },
    "textPrimary":    { "light": "#1B1A17", "dark": "#F3EFE6" },
    "textSecondary":  { "light": "#5C5850", "dark": "#B3ADA2" },
    "accent":         { "light": "#F2B705", "dark": "#F5C518" },
    "textOnAccent":   { "light": "#1B1A17", "dark": "#1B1A17" },
    "accentText":     { "light": "#835C00", "dark": "#F5C518" },
    "info":           { "light": "#2F5D9E", "dark": "#8DB4F0" },
    "success":        { "light": "#2B7449", "dark": "#6FCF97" },
    "warning":        { "light": "#8F5400", "dark": "#F2B05E" },
    "danger":         { "light": "#B3261E", "dark": "#FF8A80" },
    "dangerFill":     { "light": "#B3261E", "dark": "#B3261E" },
    "textOnDanger":   { "light": "#FFFFFF", "dark": "#FFFFFF" },
    "alarmBackground":{ "light": "#121417", "dark": "#0C0E10" },
    "alarmText":      { "light": "#F3EFE6", "dark": "#F3EFE6" }
  },
  "contrast": [
    { "fg": "textPrimary", "bg": "surface", "min": 7.0 },
    { "fg": "textPrimary", "bg": "surfaceRaised", "min": 7.0 },
    { "fg": "textSecondary", "bg": "surface", "min": 4.5 },
    { "fg": "textSecondary", "bg": "surfaceRaised", "min": 4.5 },
    { "fg": "accentText", "bg": "surface", "min": 4.5 },
    { "fg": "accentText", "bg": "surfaceRaised", "min": 4.5 },
    { "fg": "info", "bg": "surface", "min": 4.5 },
    { "fg": "success", "bg": "surface", "min": 4.5 },
    { "fg": "warning", "bg": "surface", "min": 4.5 },
    { "fg": "danger", "bg": "surface", "min": 4.5 },
    { "fg": "textOnAccent", "bg": "accent", "min": 4.5 },
    { "fg": "textOnDanger", "bg": "dangerFill", "min": 4.5 },
    { "fg": "alarmText", "bg": "alarmBackground", "min": 7.0 },
    { "fg": "border", "bg": "surface", "min": 1.2, "note": "decorative separator only; state is never conveyed by border colour alone" }
  ],
  "spacing": { "xxs": 4, "xs": 8, "sm": 12, "md": 16, "lg": 24, "xl": 32, "xxl": 48 },
  "radius": { "sm": 8, "md": 12, "lg": 20, "pill": 999 },
  "touchTarget": { "iosPoints": 44, "androidDp": 48, "alarmControlMin": 72 },
  "type": {
    "note": "Native system fonts with Dynamic Type / font scaling. Sizes are the default (large) content size; never fixed.",
    "largeTitle": { "size": 34, "weight": "bold" },
    "title": { "size": 28, "weight": "bold" },
    "title2": { "size": 22, "weight": "semibold" },
    "headline": { "size": 17, "weight": "semibold" },
    "body": { "size": 17, "weight": "regular" },
    "callout": { "size": 16, "weight": "regular" },
    "footnote": { "size": 13, "weight": "regular" },
    "alarmTime": { "size": 76, "weight": "bold", "note": "monospaced digits" }
  },
  "motion": { "quickMs": 150, "standardMs": 250, "quackMs": 600, "reducedMotion": "crossfade only" }
}
