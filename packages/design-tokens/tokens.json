    "lg": 24,
    "xl": 32,
    "xxl": 48
  },
  "layout": {
    "note": "Semantic spacing on the 4-point scale. Tight groups, generous separation, and more space above a heading than below it. Bento tiles sit 12 apart, the same as cards in a list, so a grid and a list share one rhythm.",
    "screenMarginAndroid": 20,
    "screenMarginIos": 20,
    "readableWidth": 640,
    "cardPadding": 16,
    "heroPadding": 20,
    "cardGap": 12,
    "titleGap": 4,
    "fieldLabelGap": 8,
    "controlGap": 12,
    "sectionGap": 28,
    "sectionTopExtra": 8
  },
  "radius": {
    "sm": 10,
    "md": 16,
    "lg": 22,
    "xl": 28,
    "pill": 999
  },
  "touchTarget": {
    "iosPoints": 44,
    "androidDp": 48,
    "alarmControlMin": 72,
    "controlHeight": 56
  },
  "component": {
    "note": "Visible sizes; every interactive element keeps at least touchTarget.iosPoints / androidDp of hit area even when its artwork is smaller. Full-width actions are 56 tall (Material 3 medium button, the thumb-friendly height the reviewed apps use); compact pills in headers are 40.",
    "buttonHeight": 56,
    "alarmButtonHeight": 72,
    "buttonPaddingX": 24,
    "compactControlHeight": 40,
    "chipHeight": 36,
    "iconButtonVisual": 44,
    "iconChip": 40,
    "actionCircle": 56,
    "iconSize": 24,
    "iconSizeSmall": 20,
    "iconSizeLarge": 28,
    "avatarRow": 44,
    "avatarHeader": 72,
    "tileMinHeight": 128,
    "statusPillPaddingX": 12,
    "statusPillPaddingY": 6,
    "dayToggleMax": 44
  },
  "opacity": {
    "disabled": 0.38,
    "pressedOverlay": 0.1,
    "scrim": 0.45
  },
  "elevation": {
    "note": "Cards and tiles are flat: colour separates them from the page (neutral grey on white by day, a lighter tonal surface by night), as in every reviewed app. Only overlays (sheets, menus, dialogs) cast a shadow.",
    "overlayShadowOpacity": 0.12,
    "overlayShadowRadius": 24,
    "overlayShadowY": 8,
    "overlayAndroidDp": 6
  },
  "type": {
    "note": "Semantic native type roles. Sentence-case system headlines, medium tabular time numerals and readable body text. Preserve font scaling, Dynamic Type, contrast and alarm escape control sizes.",
