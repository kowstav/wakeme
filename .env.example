# Wake Me backend configuration. Copy to .env for local use; in staging and
# production every value comes from the platform secret manager. Never commit
# real values. Unset optional integrations are disabled, not faked.

WAKEME_ENV=development            # development | test | staging | production
PORT=8080
LOG_LEVEL=info
TRUST_PROXY=false                 # true behind a trusted load balancer

# Database: runtime role only (no DDL). Migrations use MIGRATION_DATABASE_URL.
DATABASE_URL=postgres://wakeme_app:change-me@localhost:5433/wakeme?sslmode=disable
MIGRATION_DATABASE_URL=postgres://wakeme:change-me@localhost:5433/wakeme?sslmode=disable
DATABASE_POOL_MAX=10

# Identity (Supabase Auth). The API verifies access tokens against the JWKS.
AUTH_JWKS_URL=https://YOUR-PROJECT.supabase.co/auth/v1/.well-known/jwks.json
AUTH_ISSUER=https://YOUR-PROJECT.supabase.co/auth/v1
AUTH_AUDIENCE=authenticated
REAUTH_SECONDS_DELETION=900
REAUTH_SECONDS_HIGH_IMPACT_GRANTS=86400
# Worker only: deletes the identity during account deletion.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Moderators/operators: must also hold app_metadata.wakeme_role and an aal2 (MFA) session.
ADMIN_USER_IDS=

# Signs published challenge revisions (EC P-256, PKCS#8 PEM). Generate:
#   openssl ecparam -name prime256v1 -genkey -noout | openssl pkcs8 -topk8 -nocrypt
CHALLENGE_SIGNING_KEY=
CHALLENGE_SIGNING_KEY_ID=c1

# AES-256-GCM key for location coordinates (32 random bytes, base64):
#   openssl rand -base64 32
LOCATION_ENCRYPTION_KEY=
LOCATION_ENCRYPTION_KEY_ID=l1

INVITE_LINK_BASE=https://wakeme.app/i/

# APNs token auth (.p8). Topic is the iOS bundle id.
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_PRIVATE_KEY=
APNS_TOPIC=app.wakeme.ios

# FCM HTTP v1 service account (least privilege: Firebase Cloud Messaging API Admin only).
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=

# Private media storage (S3-compatible: Cloudflare R2 or Supabase Storage S3).
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true

# AI challenge drafting (server-only). Choose the runtime model from evals and cost.
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
AI_MAX_OUTPUT_TOKENS=2000
AI_INPUT_PRICE_MICROS_PER_MTOK=4000000
AI_OUTPUT_PRICE_MICROS_PER_MTOK=20000000

# RevenueCat (subscriptions). The webhook secret is the exact Authorization value configured in RevenueCat.
REVENUECAT_WEBHOOK_AUTH=
REVENUECAT_API_KEY=
REVENUECAT_ENTITLEMENT_ID=plus
