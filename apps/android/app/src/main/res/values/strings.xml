    <string name="push_nudge_title">%1$s</string>
    <string name="push_nudge_body">Quack! 🦆</string>
    <string name="push_wake_title">%1$s is waking you up</string>
    <string name="push_wake_body">Open Wake Me to start your wake-up.</string>
    <string name="push_focus_title">%1$s asks you to focus</string>
    <string name="push_focus_body">A %2$s-minute focus session. You choose whether to start it.</string>
    <string name="push_checkin_request_title">%1$s is checking on you</string>
    <string name="push_checkin_request_body">Let them know you’re OK.</string>
    <string name="push_location_request_title">%1$s asked where you are</string>
    <string name="push_location_request_body">Nothing is shared unless you choose to share.</string>
    <string name="push_outcome_acknowledged_title">%1$s</string>
    <string name="push_outcome_acknowledged_body">Saw your request 👍</string>
