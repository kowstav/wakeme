<resources>
    <string name="app_name">Wake Me</string>
    <string name="headline">Alert your friends. Wake each other up.</string>
    <string name="tagline">From “where are you?” to “we’ve got this.”</string>

    <!-- Tabs -->
    <string name="tab_friends">Friends</string>
    <string name="tab_routines">Routines</string>
    <string name="tab_challenges">Challenges</string>
    <string name="tab_you">You</string>

    <!-- Notification channels -->
    <string name="channel_quacks">Quacks from friends</string>
    <string name="channel_quacks_desc">Short sounds friends you allowed can send.</string>
    <string name="channel_alarms">Wake-up alarms</string>
    <string name="channel_alarms_desc">Alarms on this phone, including ones friends help with.</string>
    <string name="channel_requests">Requests</string>
    <string name="channel_requests_desc">Focus, check-in and location requests. Nothing is shared unless you choose.</string>
    <string name="channel_messages">Messages</string>
    <string name="channel_messages_desc">New messages. The text is never in the notification.</string>
    <string name="channel_safety">Safety</string>
    <string name="channel_safety_desc">SOS and missed check-ins from friends.</string>
    <string name="channel_updates">Routine updates</string>
    <string name="channel_updates_desc">Proposals, acceptances and outcomes.</string>

