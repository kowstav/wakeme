{
  "name": "@wakeme/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Wake Me modular-monolith backend: HTTP API process and outbox/worker process.",
  "scripts": {
    "start": "node src/entrypoints/api.ts",
    "worker": "node src/entrypoints/worker.ts",
    "migrate": "node src/entrypoints/migrate.ts",
    "resign-challenges": "node src/entrypoints/resign-challenges.ts",
    "post-restore": "node src/entrypoints/post-restore.ts",
    "dev": "node src/entrypoints/dev.ts",
    "openapi": "node src/entrypoints/openapi.ts",
    "test": "node --test --test-concurrency=1 --test-timeout=120000 \"test/**/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.131.0",
    "@fastify/rate-limit": "11.2.0",
    "@wakeme/challenges": "0.1.0",
    "@wakeme/policy": "0.1.0",
    "fastify": "5.12.5",
    "jose": "6.2.12",
    "pg": "8.23.1",
    "typebox": "1.3.34",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@types/pg": "8.23.1"
  }
}
